# Backend
JWT_SECRET=               # Secret used for JWT signing (generate a random string)

# Database
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# Frontend (exposed to browser via Vite)
VITE_GOOGLE_CLIENT_ID=    # Google OAuth Client ID

# Backend auth
APP_ORIGIN=               # Public app origin, e.g. https://verityai-1-h22e.onrender.com
GOOGLE_CLIENT_ID=         # Google OAuth Client ID (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_SECRET=     # Google OAuth Client Secret

# Admin role
OWNER_UNION_ID=           # Google account subject/user ID that should become admin on first login

# AI verification engine (Google Gemini)
GEMINI_API_KEY=           # Google Gemini API key — enables real AI verification. Get one for free at https://aistudio.google.com/app/apikey . If unset, the app falls back to a simulator.

# Squad Payments (https://squadinc.gitbook.io)
SQUAD_SECRET_KEY=         # Server-side secret (sk_test_... for sandbox, sk_live_... for prod). If unset, the wallet falls back to a simulated top-up.
SQUAD_PUBLIC_KEY=         # Public key used by the inline checkout widget (pk_test_... / pk_live_...).
SQUAD_BASE_URL=           # Optional — defaults to https://sandbox-api-d.squadco.com. Override with https://api-d.squadco.com for production.

# Optional external platform integration
KIMI_OPEN_URL=            # Defaults to https://api.kimi.com when omitted
