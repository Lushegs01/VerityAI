# ── Backend ─────────────────────────────────────────────────────
JWT_SECRET=               # Secret used for JWT signing (generate a random string)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_GOOGLE_CLIENT_ID=    # Google OAuth Client ID

# ── Backend (Auth) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=         # Google OAuth Client ID (same as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_SECRET=     # Google OAuth Client Secret

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Email of the app creator; this user gets role "admin" on first login
